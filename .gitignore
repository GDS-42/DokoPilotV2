# Client configurations hold personal data: keep them in a private repository.
# Only the demo client is versioned here.
clients/*
!clients/README.md
!clients/demo/
clients/demo/*
!clients/demo/client.yml

# Generated files and local tools
.venv/
.collections/
.ansible/
.generated/
*.retry
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Secrets in clear text never go into Git
*.decrypted.yml
.env
.env.*
!.env.example
*.agekey
keys.txt

# Operating systems and editors
.DS_Store
*.swp
.idea/
.vscode/
