# Managed by DokoPilot (Ansible): local changes are overwritten.
[Unit]
Description=Sauvegarde DokoPilot quotidienne

[Timer]
OnCalendar={{ dp.backup.schedule }}
RandomizedDelaySec={{ backup_randomized_delay }}
Persistent=true

[Install]
WantedBy=timers.target
