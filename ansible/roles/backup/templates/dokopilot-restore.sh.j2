#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Managed by DokoPilot (Ansible): local changes are overwritten.
#
# Restauration depuis le dépôt restic.
#   dokopilot-restore --confirm [--snapshot <id>|latest] [--no-pre-backup] [--forgejo]
# ou depuis le poste de l'intégrateur : bin/dokopilot restore <client> --confirm [--forgejo]
#
# Sans --forgejo : la base et les fichiers du site Dokos sont REMPLACÉS par ceux de
# l'instantané, puis le site est migré ; pendant la restauration, Dokos est fermé aux
# utilisateurs, et il le reste si elle échoue en cours de route (une base à moitié restaurée
# ne doit recevoir ni utilisateurs ni tâches planifiées).
# Avec --forgejo : les dépôts de contexte et les comptes de Forgejo sont REMPLACÉS par ceux de
# l'instantané (Dokos n'est pas touché).
#
# Avant d'écraser quoi que ce soit, l'état actuel est sauvegardé (étiquette
# « dokopilot-pre-restore ») ; --no-pre-backup s'en passe, quand l'état actuel est perdu ou
# illisible (base corrompue, service arrêté).
#
# « latest » désigne le dernier instantané de CETTE installation (étiquette install:<id>) ;
# sur un serveur neuf, qui n'en a pas encore, celui de l'unique autre installation du dépôt.
# S'il y en a plusieurs, le script les liste et demande --snapshot <id>.
set -euo pipefail
umask 077

stack_dir={{ dokopilot_stack_dir | quote }}
site={{ dp.dokos.site_name | quote }}
host_dir={{ dokopilot_bench_backup_dir | quote }}
env_file={{ backup_env_file | quote }}
install_id_file={{ backup_install_id_file | quote }}
lock_file={{ backup_lock_file | quote }}
backup_script={{ backup_script | quote }}
# Forgejo (context repositories); empty when the context is disabled.
forgejo_dir={{ (dokopilot_forgejo_dir if dp.context.enabled | default(false) | bool else '') | quote }}
forgejo_backup_dir={{ dokopilot_forgejo_backup_dir | quote }}
{% raw %}

snapshot=latest
confirmed=false
pre_backup=true
target=dokos
while (( $# > 0 )); do
  case "$1" in
    --confirm) confirmed=true ;;
    --snapshot) snapshot="${2:?--snapshot demande un identifiant}"; shift ;;
    --no-pre-backup) pre_backup=false ;;
    --forgejo) target=forgejo ;;
    *) echo "Option inconnue : $1 (attendu : --confirm [--snapshot <id>] [--no-pre-backup] [--forgejo])" >&2; exit 2 ;;
  esac
  shift
done
if [[ "$target" == forgejo && ( -z "$forgejo_dir" || ! -f "$forgejo_dir/compose.yaml" ) ]]; then
  echo "Forgejo n'est pas installé sur ce serveur (context.enabled) : rien à restaurer." >&2
  exit 2
fi
if [[ "$confirmed" != true ]]; then
  if [[ "$target" == forgejo ]]; then
    echo "La restauration remplace tous les dépôts de contexte et les comptes de Forgejo." >&2
  else
    echo "La restauration écrase la base et les fichiers actuels du site $site." >&2
  fi
  echo "Relancez avec --confirm pour la confirmer." >&2
  exit 2
fi

set -a
# shellcheck disable=SC1090
. "$env_file"
set +a

install_tag=""
if [[ -s "$install_id_file" ]]; then
  install_tag="install:$(tr -cd 'a-f0-9' < "$install_id_file")"
fi

# Resolve the snapshot to a fixed identifier first: the safety backup below must not become
# "latest", and the snapshot of another server (a test, a replacement) must never be taken
# for this one's without saying so.
selection="$(restic snapshots --json | python3 -c '
import json, sys

wanted, own = sys.argv[1], sys.argv[2]
snapshots = [s for s in json.load(sys.stdin) if {"dokopilot", "dokopilot-pre-restore"} & set(s.get("tags") or [])]


def origin(snapshot):
    return next((tag for tag in snapshot.get("tags") or [] if tag.startswith("install:")), "")


def describe(snapshot):
    where = "cette installation" if own and origin(snapshot) == own else (
        "une autre installation (%s)" % origin(snapshot) if origin(snapshot) else "une version précédente de DokoPilot")
    kind = "état sauvegardé avant une restauration, " if "dokopilot-pre-restore" in snapshot["tags"] else ""
    return "%s, du %s (UTC ou heure du serveur), serveur %s, %s%s" % (
        snapshot["short_id"], snapshot["time"][:19].replace("T", " "), snapshot.get("hostname", "?"), kind, where)


if wanted != "latest":
    found = [s for s in snapshots if s["id"].startswith(wanted) or s["short_id"] == wanted]
    if len(found) != 1:
        sys.exit("Instantané introuvable parmi les sauvegardes DokoPilot : %s" % wanted)
    chosen, note = found[0], ""
else:
    daily = [s for s in snapshots if "dokopilot" in s["tags"]]
    mine = [s for s in daily if own and origin(s) == own]
    others = sorted({origin(s) for s in daily if not own or origin(s) != own})
    if mine:
        chosen = mine[-1]
        note = ("Ce dépôt contient aussi les instantanés d’autres installations : pour en restaurer un, "
                "--snapshot <id> (liste : restic snapshots --tag dokopilot)." if others else "")
    elif len(others) == 1:
        chosen = daily[-1]
        note = "Cette installation n’a pas encore d’instantané : c’est celui de l’installation précédente du dépôt."
    elif not daily:
        sys.exit("Aucun instantané DokoPilot dans ce dépôt.")
    else:
        latest = {}
        for snapshot in daily:
            latest[origin(snapshot)] = snapshot
        sys.exit("Ce dépôt contient les instantanés de plusieurs installations ; choisissez avec --snapshot <id> :\n"
                 + "\n".join("  " + describe(snapshot) for snapshot in latest.values()))
print(chosen["short_id"])
print(describe(chosen))
print(note)
' "$snapshot" "$install_tag")" || exit 1
mapfile -t selected <<< "$selection"
snapshot="${selected[0]}"
echo "Instantané à restaurer : ${selected[1]}."
if [[ -n "${selected[2]:-}" ]]; then
  echo "${selected[2]}"
fi

pre_snapshot=""
if [[ "$pre_backup" == true ]]; then
  echo "Sauvegarde de l'état actuel avant la restauration…"
  if ! "$backup_script" --pre-restore; then
    echo "La sauvegarde de l'état actuel a échoué : restauration abandonnée, rien n'a été modifié." >&2
    echo "Si l'état actuel est perdu ou illisible (base corrompue, service arrêté), relancez avec --no-pre-backup." >&2
    exit 1
  fi
  pre_snapshot="$(restic snapshots --json --tag "dokopilot-pre-restore${install_tag:+,$install_tag}" \
    | python3 -c 'import json, sys; s = json.load(sys.stdin); print(s[-1]["short_id"] if s else "")')" || pre_snapshot=""
else
  echo "Pas de sauvegarde de l'état actuel (--no-pre-backup) : il sera remplacé sans retour possible."
fi

exec 9>"$lock_file"
if ! flock -n 9; then
  echo "Une sauvegarde ou une restauration est déjà en cours." >&2
  exit 1
fi

# ---------------------------------------------------------------------- Forgejo
if [[ "$target" == forgejo ]]; then
  fcompose() {
    docker compose --project-directory "$forgejo_dir" -f "$forgejo_dir/compose.yaml" "$@"
  }
  work="$forgejo_backup_dir/restore"
  rm -rf "$work"
  install -d -m 0700 "$work"
  trap 'rm -rf "$work"' EXIT
  echo "Lecture de l'instantané $snapshot…"
  restic restore "$snapshot" --target "$work" --include "$forgejo_backup_dir/current"
  archive="$work$forgejo_backup_dir/current/forgejo-data.tar"
  # Checked before anything is deleted.
  if [[ ! -s "$archive" ]] || ! tar -tf "$archive" > /dev/null 2>&1; then
    echo "L'instantané $snapshot ne contient pas de copie lisible des données de Forgejo : rien n'a été modifié." >&2
    exit 1
  fi
  echo "Remplacement des données de Forgejo, service arrêté…"
  fcompose stop forgejo
  # The archive goes through standard input: the account of the container is not root and
  # could not open the root-only folder that holds it.
  if ! fcompose run --rm --no-deps -T --entrypoint sh forgejo \
    -c 'find /var/lib/gitea -mindepth 1 -delete && tar -C /var/lib/gitea -xf -' < "$archive"; then
    echo "Le remplacement des données de Forgejo a ÉCHOUÉ : Forgejo reste arrêté." >&2
    if [[ -n "$pre_snapshot" ]]; then
      echo "Pour revenir à l'état d'avant : $0 --confirm --forgejo --no-pre-backup --snapshot $pre_snapshot" >&2
    fi
    exit 1
  fi
  fcompose start forgejo
  echo "Forgejo restauré (instantané $snapshot)."
  echo "Relancez maintenant « bin/dokopilot install <client> » depuis le poste de l'intégrateur (droits, mot de passe"
  echo "d'administration, jetons), puis « bin/dokopilot check <client> » et « bin/dokopilot harness » sur les postes."
  exit 0
fi

# ---------------------------------------------------------------------- Dokos
compose() {
  docker compose --project-directory "$stack_dir" -f "$stack_dir/compose.yaml" "$@"
}
services=(queue-short queue-long scheduler frontend websocket)

work="$host_dir/restore"
rm -rf "$work"
install -d -o 1000 -g 0 -m 0750 "$work"
stopped=false
restored=false
cleanup() {
  rm -rf "$work"
  if [[ "$stopped" != true ]]; then
    return
  fi
  if [[ "$restored" == true ]]; then
    compose start "${services[@]}" > /dev/null 2>&1 || true
    return
  fi
  {
    echo "La restauration a ÉCHOUÉ en cours de route : Dokos reste fermé aux utilisateurs (${services[*]} arrêtés),"
    echo "car la base peut n'être restaurée qu'à moitié."
    if [[ -n "$pre_snapshot" ]]; then
      echo "Pour revenir à l'état d'avant la restauration : $0 --confirm --no-pre-backup --snapshot $pre_snapshot"
    fi
    echo "Pour réessayer : $0 --confirm --no-pre-backup --snapshot $snapshot"
  } >&2
}
trap cleanup EXIT

echo "Lecture de l'instantané $snapshot…"
restic restore "$snapshot" --target "$work" --include "$host_dir/current"
set_dir="$work$host_dir/current"
shopt -s nullglob
pick() { # pick <suffix> [suffix to leave out]: the one file of the set ending with <suffix>
  local suffix="$1" exclude="${2:-}" file
  local found=()
  for file in "$set_dir"/*"$suffix"; do
    if [[ -n "$exclude" && "$file" == *"$exclude" ]]; then
      continue
    fi
    found+=("$file")
  done
  if (( ${#found[@]} > 1 )); then
    echo "Plusieurs fichiers *$suffix dans l'instantané." >&2
    return 1
  fi
  if (( ${#found[@]} == 1 )); then
    echo "/home/frappe/backups/restore$host_dir/current/$(basename "${found[0]}")"
  fi
}
sql_file="$(pick -database.sql.gz)"
public_file="$(pick -files.tar -private-files.tar)"
private_file="$(pick -private-files.tar)"
config_file="$(pick -site_config_backup.json)"
if [[ -z "$sql_file" ]]; then
  echo "L'instantané $snapshot ne contient pas de sauvegarde de la base : rien n'a été modifié." >&2
  exit 1
fi
chown -R 1000:0 "$work"

echo "Fermeture de Dokos aux utilisateurs et arrêt des tâches de fond pendant la restauration…"
stopped=true
compose stop frontend websocket queue-short queue-long scheduler

echo "Restauration de la base et des fichiers…"
# The database root password goes from the stack's .env to the provisioning script on
# stdin, never on a command line.
python3 - "$stack_dir/.env" "$site" "$sql_file" "$public_file" "$private_file" "$config_file" <<'PY' \
  | compose exec -T backend /home/frappe/frappe-bench/env/bin/python /opt/dokopilot/provisioning/run.py restore
import json
import sys

env_path, site, sql_file, public_file, private_file, config_file = sys.argv[1:7]
values = {}
with open(env_path, encoding="utf-8") as handle:
    for line in handle:
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            key, value = line.split("=", 1)
            values[key] = value[1:-1] if value[:1] == value[-1:] == "'" else value
json.dump(
    {
        "site": site,
        "db_root_password": values["DB_ROOT_PASSWORD"],
        "sql_file": sql_file,
        "public_file": public_file,
        "private_file": private_file,
        "site_config_file": config_file,
    },
    sys.stdout,
)
PY

echo "Migration du site…"
compose exec -T backend bench --site "$site" migrate
restored=true
echo "Restauration terminée (instantané $snapshot)."
{% endraw %}
