# Managed by DokoPilot (Ansible). Secrets: root only, never in Git.
# Read by dokopilot-backup and dokopilot-restore (shell) and usable by restic directly:
#   set -a; . {{ backup_env_file }}; set +a; restic snapshots
RESTIC_REPOSITORY='{{ dp.backup.repository }}'
RESTIC_PASSWORD='{{ secrets.restic_password }}'
{% for key, value in (secrets.restic_env | default({}, true)).items() %}
{{ key }}='{{ value }}'
{% endfor %}
