#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
"""DokoPilot command line: one entry point for every installation step.

Messages are in French (they are read by the integrator); code is in English.
Secrets are decrypted with age into a private temporary directory for the
duration of one Ansible run, then deleted.
"""

from __future__ import annotations

import argparse
import importlib.util
import json
import os
import re
import secrets as pysecrets
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import unicodedata
import urllib.parse
from contextlib import contextmanager
from pathlib import Path
from typing import Any, Iterator

REPO = Path(__file__).resolve().parent.parent
VENV_PYTHON = REPO / ".venv" / "bin" / "python"

try:
    import yaml
except ImportError:  # pragma: no cover - depends on the workstation
    # Compare environments, not interpreter files: .venv/bin/python is often a symlink to the
    # system python, so resolved paths are equal while the packages differ.
    if VENV_PYTHON.exists() and Path(sys.prefix).resolve() != (REPO / ".venv").resolve():
        os.execv(str(VENV_PYTHON), [str(VENV_PYTHON), __file__, *sys.argv[1:]])
    sys.exit("PyYAML est introuvable : lancez d'abord « make setup » à la racine du dépôt.")

ANSIBLE_DIR = REPO / "ansible"
CONFIG_DEFAULTS = ANSIBLE_DIR / "roles" / "config" / "defaults" / "main.yml"
PLAYBOOKS = ANSIBLE_DIR / "playbooks"
DEFAULT_IDENTITY = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "dokopilot" / "age-identity.txt"
SECRET_PLACEHOLDER = "generate"
# Same rule as dokopilot_person_id_regex in the config role.
PERSON_ID = re.compile(r"^(?=.{2,31}$)[a-z][a-z0-9]*(-[a-z0-9]+)*$")
# Clones synchronised by `sync`, relative to the workspace: (name shown, sub-folder).
WORKSPACE_REPOSITORIES = (("entreprise", ""), ("direction", "direction"), ("perso", "perso"))


class IndentedDumper(yaml.SafeDumper):
    """Indents block sequences, as yamllint's default configuration expects."""

    def increase_indent(self, flow: bool = False, indentless: bool = False) -> None:
        super().increase_indent(flow, False)


def dump_yaml(data: Any) -> str:
    return yaml.dump(data, Dumper=IndentedDumper, allow_unicode=True, sort_keys=False)


class CliError(Exception):
    """An error explained to the integrator, in French."""


# --------------------------------------------------------------------------- helpers


def clients_dir() -> Path:
    return Path(os.environ.get("DOKOPILOT_CLIENTS_DIR", REPO / "clients")).expanduser()


def client_dir(client: str) -> Path:
    path = clients_dir() / client
    if not (path / "client.yml").exists():
        raise CliError(f"Client « {client} » introuvable : {path / 'client.yml'} n'existe pas. Lancez « bin/dokopilot init {client} ».")
    return path


def identity_path() -> Path:
    return Path(os.environ.get("DOKOPILOT_AGE_IDENTITY", DEFAULT_IDENTITY)).expanduser()


def tool(name: str) -> str:
    venv_tool = REPO / ".venv" / "bin" / name
    if venv_tool.exists():
        return str(venv_tool)
    found = shutil.which(name)
    if not found:
        raise CliError(f"Outil « {name} » introuvable. Voir « bin/dokopilot doctor ».")
    return found


def deep_merge(base: dict[str, Any], override: dict[str, Any]) -> dict[str, Any]:
    result = dict(base)
    for key, value in override.items():
        if isinstance(value, dict) and isinstance(result.get(key), dict):
            result[key] = deep_merge(result[key], value)
        else:
            result[key] = value
    return result


def load_yaml(path: Path) -> dict[str, Any]:
    with path.open(encoding="utf-8") as handle:
        data = yaml.safe_load(handle) or {}
    if not isinstance(data, dict):
        raise CliError(f"{path} doit contenir un dictionnaire YAML.")
    return data


def client_files(client: str) -> list[Path]:
    path = client_dir(client)
    files = [path / "client.yml"]
    if (path / "client.local.yml").exists():
        files.append(path / "client.local.yml")
    return files


def allowed_settings() -> set[str]:
    """Top-level settings a client file may contain: the keys of dokopilot_defaults."""
    return set(load_yaml(CONFIG_DEFAULTS).get("dokopilot_defaults", {}))


def client_settings(client: str) -> dict[str, Any]:
    """client.yml deep-merged with client.local.yml, restricted to the documented settings.

    Client files reach Ansible as extra vars, which override every role variable: an
    unknown top-level key could silently change an internal setting of a role (groups,
    permissions, checks), so it is refused.
    """
    settings: dict[str, Any] = {}
    for path in client_files(client):
        settings = deep_merge(settings, load_yaml(path))
    unknown = sorted(set(settings) - allowed_settings())
    if unknown:
        raise CliError(
            f"Réglages inconnus pour le client « {client} » : {', '.join(unknown)}. Seuls les réglages de "
            "config/client.example.yml sont acceptés ; les variables internes des rôles ne se changent pas depuis client.yml."
        )
    check_users_format(settings)
    return settings


# --------------------------------------------------------------------------- people


def suggested_id(*candidates: str) -> str:
    """An identifier that matches PERSON_ID, from a first name or the local part of an address."""
    for candidate in candidates:
        ascii_text = unicodedata.normalize("NFKD", candidate or "").encode("ascii", "ignore").decode()
        value = re.sub(r"[^a-z0-9]+", "-", ascii_text.lower()).strip("-")[:31].strip("-")
        if PERSON_ID.match(value):
            return value
    return "dirigeant"


def check_users_format(settings: dict[str, Any]) -> None:
    """Refuse users.entrepreneur and users.assistants (version 0.1) and show the new form,
    built from the old values. The config role refuses them too, with a generic example."""
    users = settings.get("users")
    if not isinstance(users, dict) or not {"entrepreneur", "assistants"} & set(users):
        return
    entrepreneur = users.get("entrepreneur") if isinstance(users.get("entrepreneur"), dict) else {}
    assistants = [a for a in users.get("assistants") or [] if isinstance(a, dict)]
    email = str(entrepreneur.get("email") or "camille.martin@exemple.fr")
    first_name = str(entrepreneur.get("first_name") or "Camille")
    person_id = suggested_id(first_name, email.split("@")[0])
    lines = [
        "users:",
        "  people:",
        f"    - id: {person_id}",
        f"      email: {email}",
        f"      first_name: {first_name}",
        f"      last_name: {entrepreneur.get('last_name') or ''}",
        "      role: dirigeant",
    ]
    own = next((a.get("email") for a in assistants if a.get("for") == email), None)
    lines.append(f"      assistant: {'true' if own or not assistants else 'false'}")
    if own and own != f"assistant.{person_id}@{email.split('@')[-1]}":
        lines.append(f"      assistant_email: {own}")
    for assistant in assistants:
        other = str(assistant.get("for") or "")
        if other and other != email:
            lines += [
                f"    - id: {suggested_id(other.split('@')[0])}",
                f"      email: {other}",
                "      first_name: À compléter",
                "      last_name: À compléter",
                "      role: membre",
                f"      assistant_email: {assistant.get('email')}",
            ]
    raise CliError(
        "users.entrepreneur et users.assistants ne sont plus acceptés : déclarez chaque personne dans "
        "users.people (un seul dirigeant). Avec vos réglages actuels, cela donne :\n\n"
        + "\n".join(lines)
        + "\n\nVérifiez chaque id (minuscules, chiffres, tirets : il nomme les comptes et le dépôt perso-<id>) ; "
        "l'adresse d'un assistant vaut par défaut assistant.<id>@<domaine de email>."
    )


def people(settings: dict[str, Any]) -> list[dict[str, Any]]:
    users = settings.get("users")
    entries = users.get("people") if isinstance(users, dict) else None
    return [p for p in entries if isinstance(p, dict)] if isinstance(entries, list) else []


def person_for(settings: dict[str, Any], requested: str | None) -> dict[str, Any]:
    """The person a workstation command works for: --person, or by default the dirigeant."""
    declared = people(settings)
    if requested is None:
        dirigeants = [p for p in declared if p.get("role") == "dirigeant"]
        if len(dirigeants) != 1:
            raise CliError("users.people doit déclarer exactement un dirigeant (role: dirigeant) : vérifiez avec « bin/dokopilot config ».")
        chosen = dirigeants[0]
    else:
        chosen = next((p for p in declared if str(p.get("id")) == requested), {})
        if not chosen:
            ids = ", ".join(str(p.get("id")) for p in declared) or "aucune"
            raise CliError(f"Personne « {requested} » inconnue : --person prend l'id d'une personne de users.people ({ids}).")
    if not PERSON_ID.match(str(chosen.get("id", ""))):
        raise CliError(f"Identifiant de personne invalide : « {chosen.get('id')} » (minuscules, chiffres, tirets).")
    return chosen


def server_is_local(settings: dict[str, Any]) -> bool:
    """server.local: true, the server is this machine (same as --local for every command)."""
    server = settings.get("server")
    return isinstance(server, dict) and server.get("local") is True


def private_key_for(settings: dict[str, Any], user: str) -> Path | None:
    """Private key of a maintenance account, from DOKOPILOT_SSH_KEY or next to its declared public key."""
    if os.environ.get("DOKOPILOT_SSH_KEY"):
        return Path(os.environ["DOKOPILOT_SSH_KEY"]).expanduser()
    for account in settings.get("maintenance", {}).get("users", []) or []:
        if account.get("name") != user:
            continue
        for public in account.get("ssh_public_key_files", []) or []:
            path = Path(public).expanduser()
            if path.suffix == ".pub" and path.with_suffix("").exists():
                return path.with_suffix("")
    return None


def ssh_options(key: Path | None) -> list[str]:
    """Trust a server's key on first use only; offer only the account's key when it is known
    (sshd allows 3 attempts, and fail2ban counts the failures of keys offered by an agent)."""
    options = ["-o", "StrictHostKeyChecking=accept-new"]
    if key is not None:
        options += ["-o", "IdentitiesOnly=yes", "-i", str(key)]
    return options


def run(cmd: list[str], **kwargs: Any) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, check=True, text=True, **kwargs)


# --------------------------------------------------------------------------- secrets (age)


def recipients_file(client: str) -> Path:
    return clients_dir() / client / "recipients.txt"


# An age recipient: a native or plugin key (age1…), or an SSH public key (ed25519, RSA).
RECIPIENT = re.compile(r"^(age1[a-z0-9]{20,}|ssh-(ed25519|rsa) [A-Za-z0-9+/=]{40,}( .*)?)$")


def read_recipients(path: Path) -> list[str]:
    """The recipients of a recipients file, one per line; comments and blank lines are skipped."""
    if not path.exists():
        return []
    lines = (line.strip() for line in path.read_text(encoding="utf-8").splitlines())
    return [line for line in lines if line and not line.startswith("#")]


def check_recipient(key: str) -> str:
    """A recipient given on the command line, refused before it reaches recipients.txt: an
    invalid line there would make every later encryption fail."""
    key = key.strip()
    if not RECIPIENT.match(key):
        raise CliError(
            f"« {key} » n'est pas une clé publique age (elle commence par age1 ; « age-keygen -y <fichier de clé> » "
            "l'affiche) ni une clé publique SSH ed25519 ou RSA. Rien n'a été changé."
        )
    return key


def ensure_identity() -> str:
    """Return the public key of the local age identity, creating it if needed."""
    path = identity_path()
    if not path.exists():
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        run([tool("age-keygen"), "-o", str(path)], capture_output=True)
        path.chmod(0o600)
        print(f"Clé age créée : {path}. Sauvegardez-la dans votre gestionnaire de mots de passe.")
    out = run([tool("age-keygen"), "-y", str(path)], capture_output=True).stdout.strip()
    return out


def encrypt_secrets(client: str, data: dict[str, Any], recipients: list[str] | None = None) -> None:
    """Encrypts the secrets for `recipients` (default: those of recipients.txt). The previous
    encrypted file is kept as secrets.yml.age.bak: clients/ is usually outside Git."""
    if recipients is None:
        recipients = read_recipients(recipients_file(client))
    if not recipients:
        raise CliError(f"Aucun destinataire age dans {recipients_file(client)}.")
    target = clients_dir() / client / "secrets.yml.age"
    payload = yaml.safe_dump(data, allow_unicode=True, sort_keys=False)
    tmp_target = target.with_suffix(".age.tmp")
    cmd = [tool("age"), "--encrypt", "--armor", "--output", str(tmp_target)]
    for recipient in recipients:
        cmd += ["--recipient", recipient]  # public keys: nothing secret on the command line
    result = subprocess.run(cmd, input=payload, text=True, capture_output=True)
    if result.returncode != 0:
        tmp_target.unlink(missing_ok=True)
        detail = (result.stderr.strip().splitlines() or ["erreur inconnue"])[-1]
        raise CliError(
            f"Le chiffrement des secrets a échoué ({detail}). Vérifiez les clés de {recipients_file(client)} ; "
            "les secrets précédents sont inchangés."
        )
    if target.exists():
        shutil.copy2(target, target.with_suffix(".age.bak"))
    tmp_target.replace(target)


def decrypt_secrets(client: str) -> dict[str, Any]:
    source = clients_dir() / client / "secrets.yml.age"
    if not source.exists():
        raise CliError(f"Secrets introuvables : {source}. Lancez « bin/dokopilot init {client} ».")
    identity = identity_path()
    if not identity.exists():
        raise CliError(f"Clé age introuvable : {identity} (ou variable DOKOPILOT_AGE_IDENTITY).")
    result = subprocess.run([tool("age"), "--decrypt", "--identity", str(identity), str(source)], text=True, capture_output=True)
    if result.returncode != 0:
        detail = (result.stderr.strip().splitlines() or ["erreur inconnue"])[-1]
        raise CliError(
            f"Impossible de déchiffrer {source} avec la clé {identity} ({detail}).\n"
            "Cette clé n'est sans doute pas destinataire des secrets de ce client : une personne qui les déchiffre "
            f"ajoute votre clé publique avec « bin/dokopilot init {client} --recipient <clé> » "
            f"(votre clé publique : « age-keygen -y {identity} »)."
        )
    data = yaml.safe_load(result.stdout) or {}
    if not isinstance(data, dict) or "secrets" not in data:
        raise CliError(f"{source} ne contient pas de clé « secrets ».")
    return data


def private_root() -> Path:
    """Parent of the private working directories: next to the age identity, in the folder the
    harness denies to the agents (~/.config/dokopilot), never in /tmp. On a machine that is
    both the server and the workstation, an agent runs under the same account. The leading
    dot keeps the name apart from the per-client folders of that directory."""
    return identity_path().parent / ".run"


def sweep_private_root(root: Path) -> None:
    """Deletes what an interrupted run left behind (power cut, kill -9): directories are
    named after the process that owns them, and are removed once that process is gone."""
    for child in root.iterdir():
        pid = child.name.split("-", 1)[0]
        if not pid.isdigit() or int(pid) == os.getpid():
            continue
        try:
            os.kill(int(pid), 0)
        except ProcessLookupError:
            shutil.rmtree(child, ignore_errors=True)
        except OSError:
            pass  # the process exists (another account's): leave its directory


@contextmanager
def private_tempdir() -> Iterator[Path]:
    """A directory only this account reads, for decrypted secrets, deleted at the end of the
    block: also on Ctrl-C, and on a closed terminal or a kill (see main)."""
    root = private_root()
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    root.chmod(0o700)
    sweep_private_root(root)
    path = Path(tempfile.mkdtemp(prefix=f"{os.getpid()}-", dir=root))
    try:
        yield path
    finally:
        shutil.rmtree(path, ignore_errors=True)


def fill_generated(value: Any) -> Any:
    if value == SECRET_PLACEHOLDER:
        return pysecrets.token_urlsafe(24)
    if isinstance(value, dict):
        return {key: fill_generated(item) for key, item in value.items()}
    return value


# --------------------------------------------------------------------------- Ansible


def inventory(
    client: str, settings: dict[str, Any], *, user: str | None, local: bool, bootstrap: bool, ask_become_pass: bool = False
) -> dict[str, Any]:
    server = settings.get("server", {})
    maintenance_users = [u.get("name") for u in settings.get("maintenance", {}).get("users", []) if u.get("name")]
    host: dict[str, Any] = {}
    local_server = server_is_local(settings)
    if local or local_server:
        host["ansible_connection"] = "local"
    else:
        address = server.get("address")
        if not address:
            raise CliError("server.address est vide : indiquez l'adresse du serveur dans client.yml ou client.local.yml.")
        host["ansible_host"] = address
        host["ansible_port"] = int(server.get("ssh_port", 22) if not bootstrap else server.get("bootstrap_port", server.get("ssh_port", 22)))
        if bootstrap:
            host["ansible_user"] = user or server.get("bootstrap_user", "root")
        else:
            chosen = user or os.environ.get("DOKOPILOT_SSH_USER") or (maintenance_users[0] if maintenance_users else None)
            if not chosen:
                raise CliError("Aucun compte de maintenance déclaré (maintenance.users).")
            host["ansible_user"] = chosen
        key = private_key_for(settings, host["ansible_user"]) if not bootstrap or os.environ.get("DOKOPILOT_SSH_KEY") else None
        host["ansible_ssh_common_args"] = "-o StrictHostKeyChecking=accept-new" + (" -o IdentitiesOnly=yes" if key else "")
        if key is not None:
            host["ansible_ssh_private_key_file"] = str(key)
    # A variable would override the password typed for -K. On a local server, sudo uses the
    # password of the account that runs the CLI, which is never changed: it comes from -K.
    if (
        not bootstrap
        and not ask_become_pass
        and not local_server
        and settings.get("maintenance", {}).get("sudo_requires_password", True)
    ):
        host["ansible_become_password"] = "{{ secrets.maintenance_sudo_password }}"
    client_id = settings.get("client", {}).get("id", client)
    return {"dokopilot": {"hosts": {client_id: host}}}


def ansible_playbook(client: str, playbook: str, args: argparse.Namespace, *, bootstrap: bool = False, extra: list[str] | None = None) -> int:
    settings = client_settings(client)
    data = decrypt_secrets(client)
    env = dict(os.environ)
    env["ANSIBLE_CONFIG"] = str(ANSIBLE_DIR / "ansible.cfg")
    env.setdefault("ANSIBLE_FORCE_COLOR", "1")
    with private_tempdir() as tmp:
        inv = tmp / "inventory.yml"
        host_inventory = inventory(
            client, settings, user=args.user, local=args.local, bootstrap=bootstrap, ask_become_pass=args.ask_become_pass
        )
        inv.write_text(yaml.safe_dump(host_inventory), encoding="utf-8")
        # One merged file: Ansible would replace, not merge, a dict given in two -e files.
        settings_file = tmp / "client.yml"
        settings_file.write_text(dump_yaml(settings), encoding="utf-8")
        secrets_file = tmp / "secrets.yml"
        fd = os.open(secrets_file, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            yaml.safe_dump({"secrets": data["secrets"]}, handle, allow_unicode=True)
        cmd = [tool("ansible-playbook"), "-i", str(inv), "-e", f"@{settings_file}"]
        cmd += ["-e", f"@{secrets_file}", "-e", json.dumps({"dokopilot_client_dir": str(clients_dir() / client)})]
        # Tests only: extra role variables (proxy and CA of a test sandbox, small swap), never
        # client settings. Client files cannot carry them: unknown top-level keys are refused.
        if os.environ.get("DOKOPILOT_TEST_EXTRA_VARS"):
            extra_vars = Path(os.environ["DOKOPILOT_TEST_EXTRA_VARS"]).expanduser()
            print(f"Attention : variables de test ajoutées depuis {extra_vars} (DOKOPILOT_TEST_EXTRA_VARS).", file=sys.stderr)
            cmd += ["-e", f"@{extra_vars}"]
        if args.check:
            cmd.append("--check")
        if args.ask_become_pass:
            cmd.append("--ask-become-pass")
        cmd += ["-v"] * args.verbose
        cmd += extra or []
        cmd.append(str(PLAYBOOKS / playbook))
        return subprocess.run(cmd, cwd=ANSIBLE_DIR, env=env).returncode


# --------------------------------------------------------------------------- commands


def cmd_doctor(_: argparse.Namespace) -> int:
    ok = True
    checks = [
        ("python3 ≥ 3.12", sys.version_info >= (3, 12)),
        ("ansible-playbook", bool(shutil.which("ansible-playbook") or (REPO / ".venv/bin/ansible-playbook").exists())),
        ("collections Ansible", (REPO / ".collections" / "ansible_collections" / "community" / "docker").exists()),
        ("age", bool(shutil.which("age"))),
        ("age-keygen", bool(shutil.which("age-keygen"))),
        ("ssh", bool(shutil.which("ssh"))),
        ("clé SSH (~/.ssh/id_ed25519.pub)", (Path.home() / ".ssh" / "id_ed25519.pub").exists()),
    ]
    for label, passed in checks:
        print(f"{'✓' if passed else '✗'} {label}")
        ok = ok and passed
    if identity_path().exists():
        print(f"✓ clé age ({identity_path()})")
    else:
        print(f"· clé age ({identity_path()}) : sera créée par « bin/dokopilot init »")
    if not ok:
        print("\nInstallez ce qui manque : Python 3.12 ou plus avec venv (Debian, Ubuntu : apt install python3-venv make),"
              " « make setup » (Ansible), le paquet « age » de votre système, « ssh-keygen -t ed25519 » pour une clé SSH.")
    return 0 if ok else 1


def cmd_init(args: argparse.Namespace) -> int:
    target = clients_dir() / args.client
    target.mkdir(parents=True, exist_ok=True)
    client_file = target / "client.yml"
    if not client_file.exists():
        text = (REPO / "config" / "client.example.yml").read_text(encoding="utf-8")
        text = text.replace("profile: demo", f"profile: {args.profile}", 1)
        text = text.replace("  id: demo ", f"  id: {args.client} ", 1)
        if args.profile == "production":
            for before, after in (
                ("  mode: lan", "  mode: tailscale"),
                ("  repository: /var/backups/dokopilot/restic", "  repository: \"s3:https://s3.example.invalid/compartiment/dokopilot\"  # à remplacer"),
                ("  load_test_data: true", "  load_test_data: false"),
            ):
                text = text.replace(before, after, 1)
        client_file.write_text(text, encoding="utf-8")
        print(f"Créé : {client_file} (à compléter).")
    local: dict[str, Any] = load_yaml(target / "client.local.yml") if (target / "client.local.yml").exists() else {}
    if args.address:
        local = deep_merge(local, {"server": {"address": args.address}})
    if args.bootstrap_user:
        local = deep_merge(local, {"server": {"bootstrap_user": args.bootstrap_user}})
    if args.maintenance_user or args.ssh_key:
        name = args.maintenance_user or os.environ.get("USER", "integrateur")
        key = args.ssh_key or "~/.ssh/id_ed25519.pub"
        local = deep_merge(local, {"maintenance": {"users": [{"name": name, "full_name": name, "ssh_public_key_files": [key]}]}})
    if local:
        (target / "client.local.yml").write_text(
            "# Réglages propres à ce poste (ignoré par Git)\n" + dump_yaml(local), encoding="utf-8"
        )
        print(f"Mis à jour : {target / 'client.local.yml'}")
    recipients = recipients_file(args.client)
    public_key = ensure_identity()
    secrets_file = target / "secrets.yml.age"
    current = read_recipients(recipients)
    requested = [check_recipient(key) for key in args.recipient or []]
    if secrets_file.exists() and current and public_key not in current:
        # Never add a key to an existing client on its own: someone who holds the secrets does
        # it, knowingly, with --recipient. (This key could not decrypt them anyway.)
        raise CliError(
            f"La clé age de ce poste n'est pas destinataire des secrets de « {args.client} » ({recipients}).\n"
            f"Demandez à une personne qui les déchiffre de lancer : bin/dokopilot init {args.client} --recipient {public_key}\n"
            "Rien n'a été changé dans les destinataires ni dans les secrets."
        )
    wanted = list(current)
    for key in [public_key, *requested]:
        if key not in wanted:
            wanted.append(key)
    if secrets_file.exists():
        data = decrypt_secrets(args.client)
        template = load_yaml(REPO / "config" / "secrets.example.yml").get("secrets") or {}
        existing = data.get("secrets") if isinstance(data.get("secrets"), dict) else {}
        added = [key for key in template if key not in existing]
        for key in added:
            existing[key] = fill_generated(template[key])
        data["secrets"] = existing
        if added or wanted != current:
            # Encrypt first: recipients.txt changes only once the secrets are readable by all.
            encrypt_secrets(args.client, data, wanted)
            if added:
                print(f"Secrets ajoutés (absents de ce client) : {', '.join(added)}.")
            if wanted != current:
                print("Secrets rechiffrés pour les nouveaux destinataires.")
        else:
            print(f"Secrets déjà présents : {secrets_file} (inchangés).")
    else:
        template = load_yaml(REPO / "config" / "secrets.example.yml")
        encrypt_secrets(args.client, fill_generated(template), wanted)
        print(f"Secrets créés et chiffrés : {secrets_file}")
    if wanted != current:
        kept = recipients.read_text(encoding="utf-8").rstrip("\n").splitlines() if recipients.exists() else []
        recipients.write_text("\n".join([*kept, *(key for key in wanted if key not in current)]) + "\n", encoding="utf-8")
    print(f"Destinataires des secrets ({len(wanted)}) : " + ", ".join(f"{key[:16]}…" for key in wanted))
    print(
        "\nÀ conserver hors de cette machine (gestionnaire de mots de passe) : la clé age "
        f"({identity_path()}) et une copie du dossier {target} ; le mot de passe du dépôt de sauvegarde "
        f"s'affiche avec « bin/dokopilot secrets {args.client} show restic_password ». Sans eux, les sauvegardes sont illisibles."
    )
    print(f"\nÉtape suivante : vérifiez la configuration avec « bin/dokopilot config {args.client} ».")
    return 0


def cmd_config(args: argparse.Namespace) -> int:
    args.local = True
    return ansible_playbook(args.client, "config.yml", args)


def cmd_playbook(playbook: str, *, bootstrap: bool = False) -> Any:
    def handler(args: argparse.Namespace) -> int:
        # Passed as JSON: a path with a space or a typed value is one value, never parsed as
        # several key=value pairs.
        variables: dict[str, Any] = {}
        if getattr(args, "snapshot", None):
            variables["restore_snapshot"] = args.snapshot
        if getattr(args, "dest", None):
            variables["harness_dest"] = str(Path(args.dest).expanduser().resolve())
        if getattr(args, "confirm", False):
            variables["restore_confirmed"] = True
        if hasattr(args, "person"):
            variables["dokopilot_person"] = person_for(client_settings(args.client), args.person)["id"]
        extra = ["-e", json.dumps(variables)] if variables else []
        return ansible_playbook(args.client, playbook, args, bootstrap=bootstrap, extra=extra)

    return handler


# --------------------------------------------------------------------------- sync (workstation, no Ansible)


def workspace_dir(client: str, settings: dict[str, Any], dest: str | None) -> Path:
    """The workspace rendered by `harness`: --dest, or ~/DokoPilot/<client id>."""
    if dest:
        return Path(dest).expanduser().resolve()
    client_id = (settings.get("client") or {}).get("id") or client
    return Path.home() / "DokoPilot" / str(client_id)


# Every git call of `sync` runs as the harness role's helper runs them: no hook or fsmonitor
# planted in a clone runs, file names are quoted (no raw control character reaches the
# terminal), and the credential helpers are reset to the private store file (no keychain of
# the workstation receives the token, no helper written by an agent runs).
GIT_SAFE_OPTIONS = ("-c", "core.hooksPath=/dev/null", "-c", "core.fsmonitor=false", "-c", "core.quotePath=true")
# The same options, for the git commands `sync` advises the person to type.
GIT_SAFE_COMMAND = "git " + " ".join(GIT_SAFE_OPTIONS)
# Control characters (escape sequences that rewrite the terminal) and bidirectional overrides
# (text shown in another order than stored): removed from every line that comes from a commit.
UNPRINTABLE = re.compile("[\x00-\x08\x0b-\x1f\x7f-\x9f\u200e\u200f\u202a-\u202e\u2066-\u2069]")


def printable(text: str) -> str:
    return UNPRINTABLE.sub("\N{REPLACEMENT CHARACTER}", text)


def git(repo: Path, *args: str, env: dict[str, str], credentials: Path | None = None) -> subprocess.CompletedProcess[str]:
    cmd = ["git", *GIT_SAFE_OPTIONS]
    if credentials is not None:
        cmd += ["-c", "credential.helper=", "-c", f"credential.helper=store --file {shlex.quote(str(credentials))}"]
    return subprocess.run([*cmd, "-C", str(repo), *args], text=True, capture_output=True, env=env, stdin=subprocess.DEVNULL)


def workspace_git_module() -> Any:
    """The harness role's helper (ansible/roles/harness/files/workspace_git.py): `sync` checks a
    clone with the same allowlist of Git settings before it runs git in it."""
    path = REPO / "ansible" / "roles" / "harness" / "files" / "workspace_git.py"
    spec = importlib.util.spec_from_file_location("dokopilot_workspace_git", path)
    if spec is None or spec.loader is None:
        raise CliError(f"Module introuvable : {path}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def credential_hosts(credentials: Path) -> set[str]:
    """host[:port] of the entries of git's store file (git writes the port as %3a)."""
    hosts = set()
    try:
        lines = credentials.read_text(encoding="utf-8").splitlines()
    except OSError:
        return hosts
    for line in lines:
        netloc = urllib.parse.unquote(urllib.parse.urlsplit(line.strip()).netloc.rpartition("@")[2]).lower()
        if netloc:
            hosts.add(netloc)
    return hosts


def check_clone(label: str, repo: Path, client: str, credentials: Path, expected: str) -> None:
    """Refuses a clone an agent could have tampered with: unexpected Git settings (a program
    to run, another push address, a branch following another remote, a .git that points
    elsewhere), replacement objects, a nested repository or a submodule (the harness helper's
    audit), another credential helper, or a remote that is not the repository `expected`
    (<organisation>/<name>) on the Forgejo of the credential file. Nothing is sent before
    these checks."""
    module = workspace_git_module()
    advice = f"Vérifiez {repo}/.git/config, puis relancez « bin/dokopilot harness {client} » (il remet les réglages attendus)."
    try:
        module.audit(repo, label)
        helpers = module.config_values(repo, "credential.helper")
        urls = module.config_values(repo, "remote.origin.url")
    except module.Failure as exc:
        message = str(exc).replace("« bin/dokopilot harness »", f"« bin/dokopilot harness {client} »")
        raise CliError(f"{message}\nRien n'a été envoyé.") from None
    if helpers != ["", module.helper(str(credentials))]:
        raise CliError(f"« {label} » ({repo}) : le réglage credential.helper n'est pas celui de DokoPilot ; rien n'a été envoyé.\n{advice}")
    if len(urls) != 1:
        raise CliError(f"« {label} » ({repo}) : la copie n'a pas une seule adresse de serveur (remote origin) ; rien n'a été envoyé.\n{advice}")
    parts = urllib.parse.urlsplit(urls[0])
    if parts.scheme in ("http", "https"):
        if "@" in parts.netloc or parts.netloc.lower() not in credential_hosts(credentials):
            raise CliError(
                f"« {label} » ({repo}) : l'adresse du serveur ({parts.scheme}://{parts.netloc.rpartition('@')[2]}) n'est pas "
                f"celle de Forgejo, ou porte des identifiants ; rien n'a été envoyé.\n{advice}"
            )
        if not parts.path.removesuffix("/").removesuffix(".git").endswith(f"/{expected}") or parts.query or parts.fragment:
            raise CliError(
                f"« {label} » ({repo}) : la copie ne pointe pas sur le dépôt attendu ({expected}) mais sur "
                f"{printable(parts.path)} ; rien n'a été envoyé.\n{advice}"
            )
    elif os.environ.get("DOKOPILOT_TEST_LOCAL_REMOTES") == "1" and (
        parts.scheme == "file" or (parts.scheme == "" and urls[0].startswith("/") and "::" not in urls[0])
    ):
        # Tests only: a bare repository of this machine stands for Forgejo.
        print(f"Attention : dépôt local accepté pour « {label} » (DOKOPILOT_TEST_LOCAL_REMOTES).", file=sys.stderr)
    else:
        # SSH (also written user@host:path), git://, a local path, a remote helper: never Forgejo.
        raise CliError(
            f"« {label} » ({repo}) : adresse de serveur inattendue ({printable(urls[0])}) : seule l'adresse HTTP(S) de "
            f"Forgejo est acceptée ; rien n'a été envoyé.\n{advice}"
        )


def git_lines(repo: Path, *args: str, env: dict[str, str]) -> list[str]:
    result = git(repo, *args, env=env)
    return [printable(line) for line in result.stdout.splitlines()] if result.returncode == 0 else []


def git_count(repo: Path, revisions: str, env: dict[str, str]) -> int:
    lines = git_lines(repo, "rev-list", "--count", revisions, env=env)
    return int(lines[0]) if lines else 0


def rebase_in_progress(repo: Path, env: dict[str, str]) -> bool:
    for name in ("rebase-merge", "rebase-apply"):
        lines = git_lines(repo, "rev-parse", "--git-path", name, env=env)
        if lines and (repo / lines[0]).exists():
            return True
    return False


def git_failure(result: subprocess.CompletedProcess[str]) -> str:
    output = (result.stderr or result.stdout).strip().splitlines()
    return "\n".join(f"  {printable(line)}" for line in output[-8:])


def conflict_message(label: str, repo: Path, files: list[str], client: str) -> str:
    listed = ", ".join(files) if files else "voir « git status »"
    return (
        f"Conflit dans « {label} » ({repo}) : vos changements et ceux reçus du serveur touchent les mêmes "
        f"passages de : {listed}.\nRien de ce dépôt n'a été envoyé et la synchronisation s'arrête ici.\n"
        "Pour résoudre : ouvrez ces fichiers, gardez le bon texte entre les marques <<<<<<< et >>>>>>> "
        "(vous pouvez demander à votre assistant de vous aider), puis lancez :\n"
        f"  {GIT_SAFE_COMMAND} -C {shlex.quote(str(repo))} add -u && "
        f"{GIT_SAFE_COMMAND} -C {shlex.quote(str(repo))} -c core.editor=true rebase --continue\n"
        f"et relancez « bin/dokopilot sync {client} ». Pour revenir à l'état d'avant la synchronisation : "
        f"{GIT_SAFE_COMMAND} -C {shlex.quote(str(repo))} rebase --abort"
    )


def rule_paths() -> tuple[str, ...]:
    """Pathspecs of the files that steer the agents (rules, harness settings, company skills,
    what Git ignores), at any depth: one list, in the harness role's helper. A change received
    from the server is shown and accepted by the person before it is taken; a change about to
    be sent is pointed out."""
    return tuple(workspace_git_module().RULE_PATHS)


def ask_yes(question: str) -> bool:
    """A typed « oui » from the person; no answer (end of input) is no."""
    try:
        answer = input(f"{question} (o/N) ")
    except EOFError:
        print()
        return False
    return answer.strip().lower() in {"o", "oui", "y", "yes"}


def sync_repository(label: str, repo: Path, client: str, env: dict[str, str], credentials: Path, assume_yes: bool,
                    expected: str) -> str:
    """Fetch, rebase, show what would be sent, push, in one clone. Returns the summary line;
    raises at the first problem. Rules received from the server are always shown and asked
    (even with --yes); the commits to send are shown and asked unless --yes."""
    check_clone(label, repo, client, credentials, expected)
    safe_git = f"{GIT_SAFE_COMMAND} -C {shlex.quote(str(repo))}"
    paths = rule_paths()
    if rebase_in_progress(repo, env) or git_lines(repo, "diff", "--name-only", "--diff-filter=U", env=env):
        raise CliError(conflict_message(label, repo, git_lines(repo, "diff", "--name-only", "--diff-filter=U", env=env), client))
    modified = git_lines(repo, "status", "--porcelain", "--untracked-files=no", env=env)
    if modified:
        files = ", ".join(line[3:] for line in modified[:10]) + (" …" if len(modified) > 10 else "")
        raise CliError(
            f"« {label} » ({repo}) : des fichiers modifiés ne sont pas encore enregistrés dans Git : {files}.\n"
            f"Enregistrez-les ({safe_git} commit -am \"<ce qui a changé>\") ou annulez-les, "
            f"puis relancez « bin/dokopilot sync {client} ». Rien de ce dépôt n'a été envoyé."
        )
    untracked = git_lines(repo, "status", "--porcelain", "--untracked-files=all", env=env)
    head_before = (git_lines(repo, "rev-parse", "--verify", "-q", "HEAD", env=env) or [""])[0]
    if not head_before:
        raise CliError(f"« {label} » ({repo}) : la copie est encore vide ; relancez « bin/dokopilot harness {client} », qui la remplit.")
    fetch = git(repo, "fetch", "--quiet", "origin", env=env, credentials=credentials)
    if fetch.returncode != 0 or not git_lines(repo, "rev-parse", "--verify", "-q", "@{u}", env=env):
        raise CliError(
            f"« {label} » ({repo}) : la récupération des changements du serveur a échoué (réseau, identifiants ou "
            f"copie sans branche suivie) ; rien n'a été envoyé.\n{git_failure(fetch)}"
        )
    rules = git_lines(repo, "diff", "--name-only", "HEAD...@{u}", "--", *paths, env=env)
    if rules:
        print(f"\n« {label} » : les règles des agents ont changé sur le serveur ({', '.join(rules[:10])}"
              f"{' …' if len(rules) > 10 else ''}) :")
        for line in git_lines(repo, "log", "--format=  %h %an, %ad : %s", "--date=short", "HEAD..@{u}", "--", *paths, env=env):
            print(line)
        print(f"  Détail : {safe_git} diff HEAD...@{{u}} -- {' '.join(shlex.quote(name) for name in rules[:10])}")
        if not ask_yes("  Ces règles s'appliqueront à vos agents. Les accepter ?"):
            raise CliError(
                f"« {label} » : règles refusées ; rien n'a été reçu ni envoyé pour ce dépôt, et la synchronisation "
                "s'arrête ici. Voyez avec la personne qui les a changées, puis relancez."
            )
    # --no-rebase-merges: a merge commit is flattened even when the person's own Git settings
    # keep them, so that every change to send appears in the list below.
    rebase = git(repo, "rebase", "--quiet", "--no-rebase-merges", env=env)
    if rebase.returncode != 0:
        conflicts = git_lines(repo, "diff", "--name-only", "--diff-filter=U", env=env)
        if conflicts or rebase_in_progress(repo, env):
            raise CliError(conflict_message(label, repo, conflicts, client))
        raise CliError(f"« {label} » ({repo}) : la mise à jour depuis le serveur a échoué ; rien n'a été envoyé.\n{git_failure(rebase)}")
    received = git_count(repo, f"{head_before}..@{{u}}", env)
    to_send = git_count(repo, "@{u}..HEAD", env)
    parts = [f"{received} changement(s) reçu(s)" if received else ""]
    if to_send:
        print(f"\n« {label} » : {to_send} enregistrement(s) à envoyer vers Forgejo, lisibles par tous ceux qui ont accès à ce dépôt :")
        for line in git_lines(repo, "log", "--stat=100", "--format=%h %an, %ad : %s", "--date=short", "@{u}..HEAD", env=env):
            if line.strip():
                print(f"  {line}")
        # The net difference with the server is what the push really changes there, whatever
        # the shape of the history.
        print("  Au total, par rapport au serveur :")
        for line in git_lines(repo, "diff", "--stat=100", "@{u}", "HEAD", env=env):
            print(f"    {line.strip()}")
        sent_rules = git_lines(repo, "diff", "--name-only", "@{u}", "HEAD", "--", *paths, env=env)
        if sent_rules:
            print(f"  ⚠ Cet envoi change les règles des agents pour tous ceux qui ont ce dépôt : {', '.join(sent_rules[:10])}"
                  f"{' …' if len(sent_rules) > 10 else ''}. Relisez-les : {safe_git} diff @{{u}} HEAD -- "
                  f"{' '.join(shlex.quote(name) for name in sent_rules[:10])}")
        if not assume_yes and not ask_yes(f"  Envoyer ces {to_send} enregistrement(s) de « {label} » ?"):
            parts.append(f"envoi refusé, {to_send} enregistrement(s) restent sur ce poste")
            to_send = 0
        else:
            push = git(repo, "push", "--quiet", env=env, credentials=credentials)
            if push.returncode != 0:
                raise CliError(
                    f"« {label} » ({repo}) : l'envoi au serveur a été refusé ; si quelqu'un vient d'envoyer des changements, "
                    f"relancez « bin/dokopilot sync {client} ».\n{git_failure(push)}"
                )
            parts.append(f"{to_send} envoyé(s)")
    summary = ", ".join(part for part in parts if part) or "déjà à jour"
    if untracked:
        summary += f" ; {len(untracked)} nouveau(x) fichier(s) non enregistré(s) dans Git, restés sur ce poste"
    return f"✓ {label} : {summary}"


def cmd_sync(args: argparse.Namespace) -> int:
    settings = client_settings(args.client)
    person = person_for(settings, args.person)
    workspace = workspace_dir(args.client, settings, args.dest)
    if not shutil.which("git"):
        raise CliError("git est introuvable sur ce poste : installez-le (apt install git, dnf install git).")
    clones = [(label, workspace / sub) for label, sub in WORKSPACE_REPOSITORIES if (workspace / sub / ".git").exists()]
    if not clones:
        raise CliError(f"Aucune copie Git dans {workspace} : lancez d'abord « bin/dokopilot harness {args.client} » (ou indiquez --dest).")
    name = f"{person.get('first_name', '')} {person.get('last_name') or ''}".strip() or str(person["id"])
    # No inherited GIT_* variable (a Claude Code session sets the assistant's identity), never
    # a password prompt (the token is in the credential file), and commits replayed by the
    # rebase are committed by the person who synchronises.
    # GIT_NO_REPLACE_OBJECTS: what is shown is what is sent, even if a replacement object was
    # planted (the audit of each clone refuses them too).
    env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
    env.update(GIT_TERMINAL_PROMPT="0", GIT_ASKPASS="", SSH_ASKPASS="", GIT_NO_REPLACE_OBJECTS="1",
               GIT_COMMITTER_NAME=name, GIT_COMMITTER_EMAIL=str(person.get("email", "")))
    client_id = str((settings.get("client") or {}).get("id") or args.client)
    credentials = Path.home() / ".config" / "dokopilot" / client_id / "git-credentials"
    print(f"Synchronisation de {workspace} pour {name} ({person['id']}) :")
    present = {label for label, _ in clones}
    for label, sub in WORKSPACE_REPOSITORIES:
        if label not in present:
            print(f"· {label} : aucune copie sur ce poste ({workspace / sub})")
            continue
        expected = f"{client_id}/{label if label != 'perso' else 'perso-' + str(person['id'])}"
        print(sync_repository(label, workspace / sub, args.client, env, credentials, args.yes, expected), flush=True)
    print(f"Synchronisation terminée ({len(clones)} dépôt(s)).")
    return 0


def cmd_secrets(args: argparse.Namespace) -> int:
    data = decrypt_secrets(args.client)
    if args.action == "show":
        if not args.key:
            raise CliError("Indiquez la clé à afficher, ex. « bin/dokopilot secrets demo show maintenance_sudo_password ».")
        value: Any = data["secrets"]
        for part in (args.key or "").split("."):
            if part:
                if not isinstance(value, dict) or part not in value:
                    raise CliError(f"Clé « {args.key} » absente.")
                value = value[part]
        print(value if isinstance(value, str) else yaml.safe_dump(value, allow_unicode=True))
        return 0
    if args.action == "keys":
        print("\n".join(sorted(data["secrets"].keys())))
        return 0
    editor = shlex.split(os.environ.get("EDITOR") or ("nano" if shutil.which("nano") else "vi"))
    if not editor or not shutil.which(editor[0]):
        raise CliError(f"Éditeur introuvable ({os.environ.get('EDITOR') or 'nano, vi'}) : indiquez-en un avec la variable EDITOR.")
    with private_tempdir() as tmp:
        clear = tmp / "secrets.yml"
        fd = os.open(clear, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            yaml.safe_dump(data, handle, allow_unicode=True, sort_keys=False)
        while True:
            subprocess.run([*editor, str(clear)], check=True)
            try:
                edited = load_yaml(clear)
                if "secrets" not in edited or not isinstance(edited["secrets"], dict):
                    raise CliError("Le fichier modifié doit garder la clé « secrets » et ses valeurs en dessous.")
                break
            except (yaml.YAMLError, CliError) as error:
                detail = str(error).strip().splitlines()[0] if str(error).strip() else "fichier illisible"
                # A typed mistake must not lose the edit: reopen the editor when a person is there.
                if not sys.stdin.isatty() or not ask_yes(f"Le fichier n'est pas valide ({detail}). Le rouvrir pour corriger ?"):
                    raise CliError(f"Fichier de secrets non valide ({detail}). Rien n'a été changé.") from None
        encrypt_secrets(args.client, fill_generated(edited))
    print("Secrets rechiffrés (version précédente : secrets.yml.age.bak).")
    return 0


def cmd_ssh(args: argparse.Namespace) -> int:
    settings = client_settings(args.client)
    if server_is_local(settings):
        raise CliError("Le serveur est cette machine (server.local: true) : aucune session SSH n'est nécessaire.")
    inv = inventory(args.client, settings, user=args.user, local=False, bootstrap=False)
    host = next(iter(inv["dokopilot"]["hosts"].values()))
    key = private_key_for(settings, host["ansible_user"])
    cmd = ["ssh", *ssh_options(key), "-p", str(host["ansible_port"]), f"{host['ansible_user']}@{host['ansible_host']}"]
    if args.tunnel:
        cmd[1:1] = ["-L", "8080:127.0.0.1:8080"]
        print("Dokos sera joignable sur http://localhost:8080 tant que cette session est ouverte.")
    return subprocess.run(cmd).returncode


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="dokopilot", description="Installation unifiée de DokoPilot (Dokos, durcissement, sauvegardes, poste de l'entrepreneur).")
    sub = p.add_subparsers(dest="command", required=True)

    def with_common(sp: argparse.ArgumentParser) -> argparse.ArgumentParser:
        sp.add_argument("client", help="identifiant du client (dossier clients/<client>)")
        sp.add_argument("--user", help="compte SSH à utiliser (par défaut : premier compte de maintenance)")
        sp.add_argument("--local", action="store_true", help="exécuter sur cette machine (depuis le serveur lui-même ; implicite avec server.local: true)")
        sp.add_argument("--check", action="store_true", help="simulation Ansible, sans changement")
        sp.add_argument("-K", "--ask-become-pass", action="store_true", help="demander le mot de passe sudo du compte utilisé (premier passage)")
        sp.add_argument("-v", "--verbose", action="count", default=0)
        return sp

    sp = sub.add_parser("doctor", help="vérifier les outils du poste")
    sp.set_defaults(func=cmd_doctor)

    sp = sub.add_parser("init", help="créer ou compléter la configuration et les secrets d'un client")
    sp.add_argument("client")
    sp.add_argument("--profile", choices=["demo", "production"], default="demo")
    sp.add_argument("--address", help="adresse SSH du serveur ou de la VM")
    sp.add_argument("--maintenance-user", help="nom du compte de maintenance (client.local.yml)")
    sp.add_argument("--bootstrap-user", help="compte initial de l'hébergeur ou de l'installation, utilisé par bootstrap puis neutralisé")
    sp.add_argument("--ssh-key", help="chemin de la clé SSH publique de ce compte")
    sp.add_argument("--recipient", action="append", help="clé publique age supplémentaire (entrepreneur, secours)")
    sp.set_defaults(func=cmd_init)

    sp = with_common(sub.add_parser("config", help="valider et afficher la configuration effective"))
    sp.set_defaults(func=cmd_config)

    sp = with_common(sub.add_parser("bootstrap", help="premier passage avec le compte de l'hébergeur : comptes de maintenance et SSH"))
    sp.set_defaults(func=cmd_playbook("bootstrap.yml", bootstrap=True))

    sp = with_common(sub.add_parser("install", help="installer ou mettre à jour tout le serveur"))
    sp.set_defaults(func=cmd_playbook("site.yml"))

    sp = with_common(sub.add_parser("check", help="contrôles de bon fonctionnement et de sécurité"))
    sp.set_defaults(func=cmd_playbook("check.yml"))

    sp = with_common(sub.add_parser("backup", help="lancer une sauvegarde maintenant"))
    sp.set_defaults(func=cmd_playbook("backup.yml"))

    sp = with_common(sub.add_parser("restore", help="restaurer une sauvegarde (écrase le site)"))
    sp.add_argument("--snapshot", default="latest", help="instantané restic (par défaut : le plus récent)")
    sp.add_argument("--confirm", action="store_true", help="confirmer l'écrasement des données actuelles")
    sp.set_defaults(func=cmd_playbook("restore.yml"))

    sp = with_common(sub.add_parser("demo-reset", help="recharger les données de test (profil demo)"))
    sp.set_defaults(func=cmd_playbook("demo-reset.yml"))

    sp = with_common(sub.add_parser("harness", help="générer la configuration du harnais sur ce poste"))
    sp.add_argument("--dest", help="dossier de travail de la personne (par défaut : ~/DokoPilot/<client>)")
    sp.add_argument("--person", help="id de la personne qui utilise ce poste (users.people ; par défaut : le dirigeant)")
    sp.set_defaults(func=cmd_playbook("harness.yml"))

    sp = sub.add_parser("sync", help="synchroniser les copies du contexte de ce poste avec Forgejo (reçoit, montre, puis envoie)")
    sp.add_argument("client")
    sp.add_argument("--yes", action="store_true", help="envoyer sans demander (les règles reçues sont toujours montrées et demandées)")
    sp.add_argument("--person", help="id de la personne qui synchronise (users.people ; par défaut : le dirigeant)")
    sp.add_argument("--dest", help="dossier de travail (par défaut : ~/DokoPilot/<client>)")
    sp.set_defaults(func=cmd_sync)

    sp = sub.add_parser("secrets", help="lire ou modifier les secrets chiffrés")
    sp.add_argument("client")
    sp.add_argument("action", choices=["edit", "show", "keys"])
    sp.add_argument("key", nargs="?", help="clé à afficher (show), ex. maintenance_sudo_password")
    sp.set_defaults(func=cmd_secrets)

    sp = sub.add_parser("ssh", help="ouvrir une session de maintenance")
    sp.add_argument("client")
    sp.add_argument("--user")
    sp.add_argument("--tunnel", action="store_true", help="ouvrir aussi un tunnel vers Dokos (localhost:8080)")
    sp.set_defaults(func=cmd_ssh)
    return p


def stop_on_signal(number: int, _frame: Any) -> None:
    """A closed terminal (SIGHUP) or a kill (SIGTERM) ends the command as Ctrl-C does: the
    `finally` blocks run, so the directory of decrypted secrets is deleted."""
    raise SystemExit(128 + number)


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    for number in (signal.SIGHUP, signal.SIGTERM):
        signal.signal(number, stop_on_signal)
    try:
        return int(args.func(args))
    except CliError as error:
        print(f"Erreur : {error}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        print("\nInterrompu.", file=sys.stderr)
        return 130
    except subprocess.CalledProcessError as error:
        print(f"Erreur : la commande {Path(error.cmd[0]).name} a échoué (code {error.returncode}).", file=sys.stderr)
        return error.returncode or 1


if __name__ == "__main__":
    sys.exit(main())
