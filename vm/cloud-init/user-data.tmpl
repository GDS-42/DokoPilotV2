#cloud-config
# SPDX-License-Identifier: AGPL-3.0-or-later
# Local test VM: creates the maintenance account with your SSH key. The NOPASSWD
# rule written by cloud-init is removed by the maintenance role on the first install,
# after which sudo requires the password stored in the client's secrets.
hostname: @HOSTNAME@
manage_etc_hosts: true
users:
  - name: @USER@
    gecos: "Maintenance DokoPilot"
    shell: /bin/bash
    groups: [sudo]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - @SSH_KEY@
disable_root: true
ssh_pwauth: false
package_update: true
packages:
  - python3
  - sudo
  - qemu-guest-agent
growpart:
  mode: auto
  devices: ["/"]
runcmd:
  - [systemctl, enable, --now, qemu-guest-agent]
